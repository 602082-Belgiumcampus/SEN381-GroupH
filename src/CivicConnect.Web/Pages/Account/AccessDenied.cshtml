@page
@model CivicConnect.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "No access";
}

<div class="cc-auth">
    <div class="cc-panel">
        <h1>You can't open that page</h1>
        <p class="cc-lead">Your account doesn't have the role that page needs. If you think it should, ask an administrator.</p>
        <a class="btn btn-outline-primary" asp-page="/Index">Go to the home page</a>
    </div>
</div>
