@page
@model CivicConnect.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<div class="cc-auth">
    <div class="cc-panel">
        <h1>Sign out</h1>
        <p class="cc-lead">You'll need to sign in again to see your requests.</p>
        <form method="post">
            <button type="submit" class="btn btn-primary btn-lg w-100">Sign out</button>
        </form>
    </div>
</div>
