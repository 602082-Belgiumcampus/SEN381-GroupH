@page
@using CivicConnect.Modules.Lifecycle
@model LifecycleModel
@{
    ViewData["Title"] = "How requests move";
}

<div class="cc-page-head">
    <div>
        <h1>How requests move</h1>
        <p class="cc-lead">Every request follows these steps. Only the moves in the table below are allowed; anything else is refused.</p>
    </div>
</div>

<section class="cc-panel mb-4" aria-labelledby="mock-heading">
        <h2 id="mock-heading">Try it with an example request</h2>
        <p class="text-secondary">Use the buttons to move the example through its steps.</p>

        @if (Model.Refusal is not null)
        {
            <div class="alert alert-warning" role="alert">@Model.Refusal</div>
        }

        <div class="cc-track-panel px-0">
            <partial name="_StatusTrack" model="Model.Current.Status" />
        </div>

        <p>
            Current state: <strong>@LifecycleModel.Label(Model.Current.Status)</strong>.
            @if (Model.IsFinal)
            {
                <span>This state is final, so no further actions are allowed.</span>
            }
        </p>

        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var action in Model.Actions)
            {
                if (action.Allowed)
                {
                    <a class="btn btn-primary" asp-page="/Lifecycle" asp-route-steps="@action.Steps">@action.Event</a>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary" disabled>@action.Event</button>
                }
            }
            <a class="btn btn-link" asp-page="/Lifecycle">Start over</a>
        </div>

        @if (Model.History.Count > 0)
        {
            <table class="table table-sm align-middle mb-0 mt-3">
                <caption>What has happened to the mock request so far</caption>
                <thead>
                    <tr>
                        <th scope="col">Step</th>
                        <th scope="col">Action</th>
                        <th scope="col">From state</th>
                        <th scope="col">To state</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.History.Count; i++)
                    {
                        <tr>
                            <th scope="row">@(i + 1)</th>
                            <td>@Model.History[i].EventType</td>
                            <td>@LifecycleModel.Label(Model.History[i].From)</td>
                            <td>@LifecycleModel.Label(Model.History[i].To)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
</section>

<h2 class="mt-2">Allowed moves</h2>
<div class="cc-list table-responsive">
<table class="table align-middle">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">From state</th>
            <th scope="col">Action</th>
            <th scope="col">To state</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <th scope="row">@row.Id</th>
                <td>@LifecycleModel.Label(row.From)</td>
                <td>@row.Event</td>
                <td>@LifecycleModel.Label(row.To)</td>
            </tr>
        }
    </tbody>
</table>
</div>
