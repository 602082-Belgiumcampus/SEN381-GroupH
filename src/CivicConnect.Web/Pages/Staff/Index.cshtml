@page
@model CivicConnect.Web.Pages.Staff.IndexModel
@{
    ViewData["Title"] = "Work queue";
}

@if (TempData["Flash"] is string flash)
{
    <div class="alert alert-success" role="status">@flash</div>
}

<h1 class="h3">Work queue</h1>
<p class="text-muted">Oldest first. Open a request to review it.</p>

@if (Model.Requests.TotalCount == 0)
{
    <p>There are no requests for you right now.</p>
}
else
{
    <partial name="_RequestTable" model="Model.Requests.Items" />
    <partial name="_Pager" model="Model.Requests" />
}
