@page
@model CivicConnect.Web.Pages.Requests.NewModel
@{
    ViewData["Title"] = "Submit a request";
}

<div class="row">
    <div class="col-lg-8">
        <h1 class="h3 mb-1">Submit a service request</h1>
        <p class="text-muted">Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">as required</span> are required.</p>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.CategoryId" class="form-label">Category <span aria-hidden="true">*</span></label>
                <select asp-for="Input.CategoryId" asp-items="Model.Categories" class="form-select" required>
                    <option value="">Choose a category</option>
                </select>
                <span asp-validation-for="Input.CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label">Title <span aria-hidden="true">*</span></label>
                <input asp-for="Input.Title" class="form-control" required aria-describedby="title-hint" />
                <div id="title-hint" class="form-text">A short summary, for example "Broken light in the hall".</div>
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label">Description <span aria-hidden="true">*</span></label>
                <textarea asp-for="Input.Description" class="form-control" rows="6" required></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Location" class="form-label"></label>
                <input asp-for="Input.Location" class="form-control" />
                <span asp-validation-for="Input.Location" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit request</button>
            <a asp-page="/Requests/Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
