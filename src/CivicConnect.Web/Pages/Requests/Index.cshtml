@page
@model CivicConnect.Web.Pages.Requests.IndexModel
@{
    ViewData["Title"] = "My requests";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">My requests</h1>
    <a asp-page="/Requests/New" class="btn btn-primary">Submit a request</a>
</div>

@if (Model.Requests.TotalCount == 0)
{
    <p>You have not submitted any requests yet.</p>
}
else
{
    <partial name="_RequestTable" model="Model.Requests.Items" />
    <partial name="_Pager" model="Model.Requests" />
}
