@page
@model CivicConnect.Web.Pages.Requests.IndexModel
@{
    ViewData["Title"] = "My requests";
}

<div class="cc-page-head">
    <div>
        <h1>My requests</h1>
        <p class="cc-lead">Everything you've reported, newest first.</p>
    </div>
    <a asp-page="/Requests/New" class="btn btn-primary">Submit a request</a>
</div>

@if (Model.Requests.TotalCount == 0)
{
    <div class="cc-empty">
        <p>You haven't submitted any requests yet. When you do, you can follow each one here.</p>
        <a asp-page="/Requests/New" class="btn btn-primary">Submit your first request</a>
    </div>
}
else
{
    <partial name="_RequestTable" model="Model.Requests.Items" />
    <partial name="_Pager" model="Model.Requests" />
}
