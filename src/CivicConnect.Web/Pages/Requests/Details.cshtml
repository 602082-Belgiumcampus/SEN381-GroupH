@page "{id:guid}"
@model CivicConnect.Web.Pages.Requests.DetailsModel
@{
    var request = Model.Detail;
    ViewData["Title"] = request.Reference;
}

@if (TempData["Flash"] is string flash)
{
    <div class="alert alert-success" role="status">@flash</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
    <h1 class="h3 mb-0">@request.Title</h1>
    <partial name="_StatusBadge" model="request.Status" />
</div>
<p class="text-muted">Reference <strong>@request.Reference</strong> · @request.Category</p>

<div class="row g-4">
    <div class="col-lg-8">
        <section class="card mb-4" aria-labelledby="details-heading">
            <div class="card-body">
                <h2 class="h5" id="details-heading">Details</h2>
                <p class="mb-3" style="white-space: pre-line">@request.Description</p>
                <dl class="row mb-0">
                    @if (request.Location is not null)
                    {
                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@request.Location</dd>
                    }
                    @if (Model.ShowRequester)
                    {
                        <dt class="col-sm-4">Requester</dt>
                        <dd class="col-sm-8">@request.RequesterName</dd>
                    }
                    <dt class="col-sm-4">Submitted</dt>
                    <dd class="col-sm-8">@request.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</dd>
                    @if (request.AssignedToName is not null)
                    {
                        <dt class="col-sm-4">Assigned to</dt>
                        <dd class="col-sm-8">@request.AssignedToName</dd>
                    }
                    @if (request.RejectionReason is not null)
                    {
                        <dt class="col-sm-4">Reason for rejection</dt>
                        <dd class="col-sm-8">@request.RejectionReason</dd>
                    }
                    @if (request.ResolutionNote is not null)
                    {
                        <dt class="col-sm-4">Resolution</dt>
                        <dd class="col-sm-8">@request.ResolutionNote</dd>
                    }
                </dl>
            </div>
        </section>

        <section aria-labelledby="history-heading">
            <h2 class="h5" id="history-heading">History</h2>
            <ol class="list-group list-group-numbered">
                @foreach (var item in request.History)
                {
                    <li class="list-group-item">
                        <strong>@(item.From is RequestStatus from ? $"{StatusDisplay.Label(from)} → " : "")@StatusDisplay.Label(item.To)</strong>
                        by @item.ActorName,
                        <time datetime="@item.OccurredAt.ToString("O")">@item.OccurredAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</time>
                        @if (item.EventType == "Reject" && item.Detail is not null)
                        {
                            <div class="text-muted small">Reason: @item.Detail</div>
                        }
                    </li>
                }
            </ol>
        </section>
    </div>

    @if (Model.CanAccept || Model.CanReject)
    {
        <div class="col-lg-4">
            <section class="card" aria-labelledby="review-heading">
                <div class="card-body">
                    <h2 class="h5" id="review-heading">Review this request</h2>
                    <p class="text-muted small">Accept it to take it forward, or reject it with a reason the requester will see.</p>

                    @if (Model.CanAccept)
                    {
                        <form method="post" asp-page-handler="Accept" asp-route-id="@request.Id" class="mb-4">
                            <input type="hidden" asp-for="Version" />
                            <button type="submit" class="btn btn-success w-100">Accept request</button>
                        </form>
                    }

                    @if (Model.CanReject)
                    {
                        <form method="post" asp-page-handler="Reject" asp-route-id="@request.Id">
                            <input type="hidden" asp-for="Version" />
                            <div class="mb-2">
                                <label asp-for="RejectionReason" class="form-label">Reason for rejecting</label>
                                <textarea asp-for="RejectionReason" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="RejectionReason" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-outline-danger w-100">Reject request</button>
                        </form>
                    }
                </div>
            </section>
        </div>
    }
</div>

<p class="mt-4">
    @if (User.IsInRole("Requester") && !Model.ShowRequester)
    {
        <a asp-page="/Requests/Index">Back to my requests</a>
    }
    else
    {
        <a asp-page="/Staff/Index">Back to the work queue</a>
    }
</p>
