@page "{id:guid}"
@model CivicConnect.Web.Pages.Requests.DetailsModel
@{
    var request = Model.Detail;
    ViewData["Title"] = request.Reference;

    string HistoryLabel(HistoryItem item) => item.EventType switch
    {
        "Submit" => "Submitted",
        "Start" => "Work started",
        _ => StatusDisplay.Label(item.To)
    };
}

@if (TempData["Flash"] is string flash)
{
    <div class="alert alert-success" role="status">@flash</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}

<header class="cc-request-head">
    <div class="cc-request-head__ref">@request.Reference</div>
    <h1>@request.Title</h1>
    <div class="cc-request-head__meta">
        <span>@request.Category</span>
        <span>Submitted @request.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</span>
        <partial name="_StatusBadge" model="request.Status" />
    </div>
</header>

<section class="cc-panel cc-track-panel" aria-label="Progress">
    <partial name="_StatusTrack" model="request.Status" />
</section>

<div class="row g-4">
    <div class="col-lg-8 order-2 order-lg-1">
        <section class="cc-panel" aria-labelledby="details-heading">
            <h2 id="details-heading">What was reported</h2>
            <p class="cc-description">@request.Description</p>

            <dl class="cc-facts">
                @if (request.Location is not null)
                {
                    <dt>Location</dt>
                    <dd>@request.Location</dd>
                }
                @if (Model.ShowRequester)
                {
                    <dt>Reported by</dt>
                    <dd>@request.RequesterName</dd>
                }
                <dt>Assigned to</dt>
                <dd>@(request.AssignedToName ?? "Not assigned yet")</dd>
                @if (request.ClosedAt is DateTimeOffset closedAt)
                {
                    <dt>Closed</dt>
                    <dd>@closedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
                }
            </dl>

            @if (request.ResolutionNote is not null)
            {
                <div class="cc-note cc-note--done">
                    <strong>What was done</strong>
                    <p>@request.ResolutionNote</p>
                </div>
            }
            @if (request.RejectionReason is not null)
            {
                <div class="cc-note cc-note--stopped">
                    <strong>Why it was rejected</strong>
                    <p>@request.RejectionReason</p>
                </div>
            }
        </section>

        <section class="cc-panel" aria-labelledby="history-heading">
            <h2 id="history-heading">History</h2>
            <ol class="cc-history">
                @foreach (var item in request.History)
                {
                    <li>
                        <div class="cc-history__what">@HistoryLabel(item)</div>
                        <div class="cc-history__who">
                            @item.ActorName,
                            <time datetime="@item.OccurredAt.ToString("O")">@item.OccurredAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</time>
                        </div>
                        @if (item.EventType == "Reject" && item.Detail is not null)
                        {
                            <div class="cc-history__why">Reason: @item.Detail</div>
                        }
                    </li>
                }
            </ol>
        </section>
    </div>

    <div class="col-lg-4 order-1 order-lg-2">
        @if (Model.Actions.Count > 0)
        {
            <section class="cc-panel cc-next" aria-labelledby="actions-heading">
                <h2 id="actions-heading">Next step</h2>

                @if (Model.CanAct(LifecycleEvent.Accept) || Model.CanAct(LifecycleEvent.Reject))
                {
                    <p>Accept it to take it forward, or reject it with a reason the requester will see.</p>
                }

                @if (Model.CanAct(LifecycleEvent.Accept))
                {
                    <form method="post" asp-page-handler="Accept" asp-route-id="@request.Id">
                        <input type="hidden" asp-for="Version" />
                        <button type="submit" class="btn btn-success w-100">Accept request</button>
                    </form>
                }

                @if (Model.CanAct(LifecycleEvent.Reject))
                {
                    <form method="post" asp-page-handler="Reject" asp-route-id="@request.Id">
                        <input type="hidden" asp-for="Version" />
                        <div class="mb-2">
                            <label asp-for="RejectionReason" class="form-label">Reason for rejecting</label>
                            <textarea asp-for="RejectionReason" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="RejectionReason" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-outline-danger w-100">Reject request</button>
                    </form>
                }

                @if (Model.CanAct(LifecycleEvent.Assign))
                {
                    @if (Model.CanAssignOthers)
                    {
                        <p>Choose who will do the work.</p>
                        <form method="post" asp-page-handler="Assign" asp-route-id="@request.Id">
                            <input type="hidden" asp-for="Version" />
                            <div class="mb-3">
                                <label asp-for="AssigneeId" class="form-label">Assign to</label>
                                <select asp-for="AssigneeId" asp-items="Model.StaffOptions" class="form-select">
                                    <option value="">Choose a staff member</option>
                                </select>
                                <span asp-validation-for="AssigneeId" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Assign request</button>
                        </form>
                    }
                    else
                    {
                        <p>Take this request to work on it yourself.</p>
                        <form method="post" asp-page-handler="AssignToMe" asp-route-id="@request.Id">
                            <input type="hidden" asp-for="Version" />
                            <button type="submit" class="btn btn-primary w-100">Assign to me</button>
                        </form>
                    }
                }

                @if (Model.CanAct(LifecycleEvent.Start))
                {
                    <p>This request is assigned to you. Start it when you begin the work.</p>
                    <form method="post" asp-page-handler="Start" asp-route-id="@request.Id">
                        <input type="hidden" asp-for="Version" />
                        <button type="submit" class="btn btn-primary w-100">Start work</button>
                    </form>
                }

                @if (Model.CanAct(LifecycleEvent.Resolve))
                {
                    <p>Describe what was done. The requester will see this note.</p>
                    <form method="post" asp-page-handler="Resolve" asp-route-id="@request.Id">
                        <input type="hidden" asp-for="Version" />
                        <div class="mb-3">
                            <label asp-for="ResolutionNote" class="form-label">What was done</label>
                            <textarea asp-for="ResolutionNote" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="ResolutionNote" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Mark as resolved</button>
                    </form>
                }

                @if (Model.CanAct(LifecycleEvent.Close))
                {
                    <p>The work is done. Close the request to finish it.</p>
                    <form method="post" asp-page-handler="Close" asp-route-id="@request.Id">
                        <input type="hidden" asp-for="Version" />
                        <button type="submit" class="btn btn-dark w-100">Close request</button>
                    </form>
                }
            </section>
        }
        else
        {
            <section class="cc-panel" aria-labelledby="where-heading">
                <h2 id="where-heading">Where it is now</h2>
                <p class="cc-waiting mb-0">@StatusDisplay.Explain(request.Status)</p>
            </section>
        }

        <p class="mt-3">
            @if (User.IsInRole("Requester") && !Model.ShowRequester)
            {
                <a asp-page="/Requests/Index">Back to my requests</a>
            }
            else
            {
                <a asp-page="/Staff/Index">Back to the work queue</a>
            }
        </p>
    </div>
</div>
