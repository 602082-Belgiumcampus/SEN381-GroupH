@model PagedResult<RequestSummary>

@if (Model.PageCount > 1)
{
    <nav aria-label="Pages" class="cc-pager">
        @if (Model.HasPrevious)
        {
            <a class="btn btn-outline-primary btn-sm" asp-route-pageNumber="@(Model.Page - 1)">Previous page</a>
        }
        <span>Page @Model.Page of @Model.PageCount</span>
        @if (Model.HasNext)
        {
            <a class="btn btn-outline-primary btn-sm" asp-route-pageNumber="@(Model.Page + 1)">Next page</a>
        }
    </nav>
}
