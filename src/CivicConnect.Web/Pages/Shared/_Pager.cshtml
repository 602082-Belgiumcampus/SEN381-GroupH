@model PagedResult<RequestSummary>

@if (Model.PageCount > 1)
{
    <nav aria-label="Pages" class="d-flex align-items-center gap-3">
        @if (Model.HasPrevious)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-route-pageNumber="@(Model.Page - 1)">Previous</a>
        }
        <span>Page @Model.Page of @Model.PageCount</span>
        @if (Model.HasNext)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-route-pageNumber="@(Model.Page + 1)">Next</a>
        }
    </nav>
}
