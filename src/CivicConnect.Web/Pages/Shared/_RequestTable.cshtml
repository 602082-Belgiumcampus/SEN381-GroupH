@model IReadOnlyList<RequestSummary>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Reference</th>
                <th scope="col">Title</th>
                <th scope="col">Category</th>
                <th scope="col">Status</th>
                <th scope="col">Submitted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td><a asp-page="/Requests/Details" asp-route-id="@request.Id">@request.Reference</a></td>
                    <td>@request.Title</td>
                    <td>@request.Category</td>
                    <td><partial name="_StatusBadge" model="request.Status" /></td>
                    <td><time datetime="@request.CreatedAt.ToString("O")">@request.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</time></td>
                </tr>
            }
        </tbody>
    </table>
</div>
