@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="cc-auth">
    <div class="cc-panel">
        <h1>Something went wrong</h1>
        <p class="cc-lead">That didn't work. Try again, or go back to the <a asp-page="/Index">home page</a>.</p>

        @if (Model.ShowRequestId)
        {
            <p class="mb-0">If it keeps happening, quote this reference when you report it: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
