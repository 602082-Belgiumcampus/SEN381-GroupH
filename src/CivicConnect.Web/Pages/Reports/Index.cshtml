@page
@model CivicConnect.Web.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
    var summary = Model.Summary;
    string Days(double? days) => days is double d ? $"{d:0.0} days" : "None resolved yet";
}

<div class="cc-page-head">
    <div>
        <h1>Reports</h1>
        <p class="cc-lead">How many requests came in, where they are now, which are overdue, and who handled them.</p>
    </div>
</div>

@if (Model.FilterError is not null)
{
    <div class="alert alert-warning" role="alert">@Model.FilterError</div>
}

<form method="get" class="cc-filters" aria-label="Report period and category">
    <div>
        <label for="report-from" class="form-label">From</label>
        <input id="report-from" name="From" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div>
        <label for="report-to" class="form-label">To</label>
        <input id="report-to" name="To" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div>
        <label for="report-category" class="form-label">Category</label>
        <select id="report-category" name="CategoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
            }
        </select>
    </div>
    <div class="cc-filters__buttons">
        <button type="submit" class="btn btn-primary">Show</button>
        @if (Model.IsFiltered)
        {
            <a class="btn btn-link" asp-page="/Reports/Index">All time</a>
        }
    </div>
</form>
<p class="form-text mt-n2 mb-4">Dates are the day a request was submitted (UTC). Staff activity uses the day the action happened.</p>

<section aria-labelledby="totals-heading" class="mb-4">
    <h2 id="totals-heading" class="visually-hidden">Totals</h2>
    <div class="cc-stats">
        <div class="cc-stat"><span class="cc-stat__value">@summary.Total</span><span class="cc-stat__label">Requests</span></div>
        <div class="cc-stat"><span class="cc-stat__value">@summary.Open</span><span class="cc-stat__label">Still open</span></div>
        <div class="cc-stat cc-stat--alert"><span class="cc-stat__value">@summary.Overdue</span><span class="cc-stat__label">Overdue</span></div>
        <div class="cc-stat"><span class="cc-stat__value cc-stat__value--small">@Days(summary.AverageDaysToResolve)</span><span class="cc-stat__label">Average time to resolve</span></div>
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-4">
        <section class="cc-panel h-100" aria-labelledby="status-heading">
            <h2 id="status-heading">By status</h2>
            <table class="table table-sm mb-0">
                <thead><tr><th scope="col">Status</th><th scope="col" class="text-end">Requests</th></tr></thead>
                <tbody>
                    @foreach (var row in summary.ByStatus)
                    {
                        <tr><td><partial name="_StatusBadge" model="row.Status" /></td><td class="text-end">@row.Count</td></tr>
                    }
                </tbody>
            </table>
        </section>
    </div>
    <div class="col-lg-8">
        <section class="cc-panel h-100" aria-labelledby="category-heading">
            <h2 id="category-heading">By category</h2>
            @if (summary.ByCategory.Count == 0)
            {
                <p class="cc-waiting mb-0">No requests in this period.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Category</th>
                                <th scope="col" class="text-end">Target</th>
                                <th scope="col" class="text-end">Requests</th>
                                <th scope="col" class="text-end">Open</th>
                                <th scope="col" class="text-end">Overdue</th>
                                <th scope="col" class="text-end">Avg. to resolve</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in summary.ByCategory)
                            {
                                <tr>
                                    <th scope="row">@row.Category</th>
                                    <td class="text-end">@row.TargetResolutionDays days</td>
                                    <td class="text-end">@row.Total</td>
                                    <td class="text-end">@row.Open</td>
                                    <td class="text-end">@row.Overdue</td>
                                    <td class="text-end">@(row.AverageDaysToResolve is double d ? $"{d:0.0} days" : "–")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

<section class="cc-panel mt-4" aria-labelledby="overdue-heading">
    <h2 id="overdue-heading">Overdue requests</h2>
    <p class="form-text">Open requests older than their category's target. Most overdue first.</p>
    @if (Model.Overdue.TotalCount == 0)
    {
        <p class="cc-waiting mb-0">Nothing is overdue.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Request</th>
                        <th scope="col">Status</th>
                        <th scope="col">Assigned to</th>
                        <th scope="col" class="text-end">Days overdue</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Overdue.Items)
                    {
                        <tr>
                            <td><a class="cc-ref" asp-page="/Requests/Details" asp-route-id="@item.Id">@item.Reference</a></td>
                            <td>
                                <div class="cc-list__title">@item.Title</div>
                                <div class="text-secondary small">@item.Category, due @item.DueAt.ToLocalTime().ToString("d MMM yyyy")</div>
                            </td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                            <td>@(item.AssignedTo ?? "Not assigned")</td>
                            <td class="text-end"><strong>@item.DaysOverdue</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Overdue" />
    }
</section>

<section class="cc-panel mt-4" aria-labelledby="activity-heading">
    <h2 id="activity-heading">Who did what</h2>
    <p class="form-text">Actions per person, counted from the audit trail.</p>
    @if (Model.Activity.Count == 0)
    {
        <p class="cc-waiting mb-0">No staff actions in this period.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th scope="col">Staff member</th>
                        <th scope="col" class="text-end">Accepted</th>
                        <th scope="col" class="text-end">Rejected</th>
                        <th scope="col" class="text-end">Assigned</th>
                        <th scope="col" class="text-end">Started</th>
                        <th scope="col" class="text-end">Resolved</th>
                        <th scope="col" class="text-end">Closed</th>
                        <th scope="col" class="text-end">Reopened</th>
                        <th scope="col" class="text-end">Actions logged</th>
                        <th scope="col" class="text-end">Logged for others</th>
                        <th scope="col" class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Activity)
                    {
                        <tr>
                            <th scope="row">@row.StaffName</th>
                            <td class="text-end">@row.Accepted</td>
                            <td class="text-end">@row.Rejected</td>
                            <td class="text-end">@row.Assigned</td>
                            <td class="text-end">@row.Started</td>
                            <td class="text-end">@row.Resolved</td>
                            <td class="text-end">@row.Closed</td>
                            <td class="text-end">@row.Reopened</td>
                            <td class="text-end">@row.ActionsRecorded</td>
                            <td class="text-end">@row.LoggedOnBehalf</td>
                            <td class="text-end"><strong>@row.Total</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
