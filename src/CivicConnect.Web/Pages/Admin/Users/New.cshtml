@page
@model CivicConnect.Web.Pages.Admin.Users.NewModel
@using CivicConnect.Modules.IdentityAccess
@{
    ViewData["Title"] = "Create a user";
}

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="cc-page-head">
            <div>
                <h1>Create a user</h1>
                <p class="cc-lead">For staff, supervisors, managers and administrators. Requesters can create their own account.</p>
            </div>
        </div>

        <form method="post" novalidate class="cc-panel">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.DisplayName" class="form-label"></label>
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Role" class="form-label"></label>
                <select asp-for="Input.Role" asp-items="Html.GetEnumSelectList<Role>()" class="form-select">
                    <option value="">Choose a role</option>
                </select>
                <span asp-validation-for="Input.Role" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.InitialPassword" class="form-label"></label>
                <input asp-for="Input.InitialPassword" class="form-control" autocomplete="new-password" aria-describedby="password-hint" />
                <div id="password-hint" class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</div>
                <span asp-validation-for="Input.InitialPassword" class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="submit" class="btn btn-primary">Create user</button>
                <a asp-page="/Admin/Users/Index" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
