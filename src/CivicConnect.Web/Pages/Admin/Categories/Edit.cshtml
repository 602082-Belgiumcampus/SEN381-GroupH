@page "{id:guid}"
@model CivicConnect.Web.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Category.Name}";
}

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="cc-page-head">
            <div>
                <h1>Edit category</h1>
                <p class="cc-lead">@Model.Category.RequestCount @(Model.Category.RequestCount == 1 ? "request uses" : "requests use") this category. They keep it whatever you change here.</p>
            </div>
        </div>

        <form method="post" novalidate class="cc-panel">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TargetResolutionDays" class="form-label"></label>
                <input asp-for="Input.TargetResolutionDays" class="form-control" type="number" min="1" max="@AdminRules.MaxTargetResolutionDays" aria-describedby="target-hint" />
                <div id="target-hint" class="form-text">Changing this changes which open requests count as overdue straight away.</div>
                <span asp-validation-for="Input.TargetResolutionDays" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label"></label>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="submit" class="btn btn-primary">Save category</button>
                <a asp-page="/Admin/Categories/Index" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
